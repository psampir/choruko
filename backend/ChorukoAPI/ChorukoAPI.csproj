<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="DTOs\**" />
      <Content Remove="DTOs\**" />
      <EmbeddedResource Remove="DTOs\**" />
      <None Remove="DTOs\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Proxies" Version="10.0.15" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageReference Include="SkiaSharp" Version="4.156.0" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.156.0" />
        <PackageReference Include="Swashbuckle.AspNetCore.Filters" Version="10.0.1" />
        <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.3.1" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.1" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
        <PackageReference Include="WebPush" Version="1.0.12" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="wwwroot\" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="Mappers\obj\ChorukoAPI.csproj.nuget.dgspec.json" />
      <_ContentIncludedByDefault Remove="Mappers\obj\Debug\net10.0\ChorukoAPI.sourcelink.json" />
      <_ContentIncludedByDefault Remove="Mappers\obj\Debug\net10.0\rjimswa.dswa.cache.json" />
      <_ContentIncludedByDefault Remove="Mappers\obj\Debug\net10.0\rjsmcshtml.dswa.cache.json" />
      <_ContentIncludedByDefault Remove="Mappers\obj\Debug\net10.0\rjsmrazor.dswa.cache.json" />
      <_ContentIncludedByDefault Remove="Mappers\obj\Debug\net10.0\rpswa.dswa.cache.json" />
      <_ContentIncludedByDefault Remove="Mappers\obj\Debug\net10.0\staticwebassets.build.endpoints.json" />
      <_ContentIncludedByDefault Remove="Mappers\obj\Debug\net10.0\staticwebassets.build.json" />
      <_ContentIncludedByDefault Remove="Mappers\obj\Debug\net10.0\staticwebassets.development.json" />
      <_ContentIncludedByDefault Remove="Mappers\obj\project.assets.json" />
      <_ContentIncludedByDefault Remove="Mappers\obj\project.packagespec.json" />
    </ItemGroup>

</Project>
