# Build React app
FROM node:24.2-alpine3.21 AS build
WORKDIR /app
COPY frontend/choruko-frontend/ ./
RUN npm install
RUN npm run build

# Serve with nginx
FROM nginx:1.28.0-alpine3.21-slim
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/nginx.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

