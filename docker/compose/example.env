# You can find documentation for all the supported env variables at https://github.com/psampir/choruko/blob/main/README.md

# The Choruko version to use. You can pin this to a specific version like "v1.0.0" or use "release" to always use the latest stable version
CHORUKO_VERSION=release

# By default, Choruko runs on port 2467. To set a custom port for the Choruko web interface, uncomment the next line and set your desired port number
# CHORUKO_PORT=2467

# The location where application files like profile and household pictures are stored
APP_DATA_LOCATION=./app_data

# By default, Choruko uses host's timezone. If you want to set a specific timezone, uncomment the next line and change Etc/UTC to your desired TZ identifier from this list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
# TZ=Etc/UTC

# The currency used in Choruko. Set this to your local currency code from this list: https://www.iban.com/currency-codes
CURRENCY=USD

# Email settings for sending password reset emails to users. If disabled, users will not be able to reset their passwords themselves (passwords can also be reset via command line).
ENABLE_EMAILS=false                    # Set to true  to enable sending emails
# SMTP_HOST=smtp.example.com           # Server address (e.g., smtp.gmail.com)
# SMTP_PORT=587                        # 587 (TLS) or 465 (SSL)
# SMTP_USERNAME=your@email.com         # Full email address or username
# SMTP_PASSWORD=your_password          # App password/API key
# SMTP_FROM=Your App <no-reply@example.com>  # Sender identity
# SERVER_URL=https://your-server-url.com      # Publicly accessible URL of your Choruko instance (used in email links)

# The location where your database files are stored. Network shares are not supported for the database
DB_DATA_LOCATION=./db_data

# Connection secret for the database. You should change it to a random password
# Please use only the characters `A-Za-z0-9`, without special characters or spaces
DB_PASSWORD=postgres

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=choruko
