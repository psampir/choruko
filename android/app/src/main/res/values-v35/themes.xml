<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Android 15 (API 35) draws apps that target SDK 35 edge-to-edge and ignores the
      window background behind the bars. Opting out here restores the pre-15 layout
      for this Android version; from API 36 the flag is ignored, which is why
      WindowInsets.kt pads the content by the system bar insets as well.
    -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/web_background</item>
        <item name="android:statusBarColor">@color/web_background</item>
        <item name="android:navigationBarColor">@color/web_background</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/setup_accent</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="SetupTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/setup_background</item>
        <item name="android:statusBarColor">@color/setup_background</item>
        <item name="android:navigationBarColor">@color/setup_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/setup_accent</item>
        <item name="android:textColorPrimary">@color/setup_text</item>
        <item name="android:textColorSecondary">@color/setup_text_secondary</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

</resources>
