        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="change_server"
        android:shortcutLongLabel="@string/change_server_long"
        android:shortcutShortLabel="@string/change_server_action">
        <intent
            android:action="com.psampir.choruko.CHANGE_SERVER"
            android:targetClass="com.psampir.choruko.MainActivity"
            android:targetPackage="com.psampir.choruko" />
    </shortcut>
</shortcuts>
