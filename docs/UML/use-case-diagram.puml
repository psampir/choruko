@startuml use-case-diagram

' TITLE
title Choruko System - Use Case Diagram

' STYLING (optional)
skinparam usecaseBorderColor #000000
skinparam usecaseBackgroundColor #EEEEEE
skinparam packageStyle rectangle
skinparam linetype ortho
' Use vertical layout
left to right direction

' ACTORS
:Unlogged User: as u_user
:Logged User: as l_user
:System: as system

' SYSTEM BOUNDARY
rectangle "Choruko System" #LightBlue {
  ' Use packages to group related use cases
  package "Account Management" {
    usecase "Login" as UC1
    usecase "Register Account" as UC2
    usecase "Delete Account" as UC3
    usecase "Request password reset Email" as UC37
  }
  
  package "Household Management"{
    usecase "Create Household" as UC4
    usecase "Delete Household" as UC5
    usecase "Transfer Admin Rights" as UC6
    usecase "Send Household Invitation" as UC7
    usecase "Remove Participant" as UC8
    usecase "View Invitations Panel" as UC9
    usecase "Accept Invitation" as UC10
    usecase "Decline Invitation" as UC11
    usecase "Leave Household" as UC12
  }
  
  package "Dashboard" {
    usecase "View Summary" as UC13
  }
  
  package "Task Management" {
    usecase "Create Task Type" as UC14
    usecase "Edit Task Type" as UC15
    usecase "Delete Task Type" as UC16
    usecase "Create Task" as UC17
    usecase "Delete Task" as UC18
    usecase "Assign Task" as UC19
    usecase "Edit Task" as UC20
    usecase "Mark Task as Completed" as UC21
    usecase "Unmark Task as Completed" as UC22
  }
  
  package "Settlements & Finances" {
    usecase "View Settlements Panel" as UC23
    usecase "View Settlement Details" as UC24
    usecase "Add Transaction" as UC25
    usecase "Edit Transaction" as UC26
    usecase "Delete Transaction" as UC27
    usecase "Mark Settlement as Completed" as UC28
    usecase "Unmark Settlement as Completed" as UC29
  }
  
  package "Notifications" {
    usecase "View Notifications Panel" as UC30
    usecase "Delete Notification" as UC31
    usecase "Clear All Notifications" as UC32
  }
  
  package "System Actions"{
    usecase "Send Password Reset Email" as UC33
    usecase "Add Points for Task" as UC34
    usecase "Send Task Notification" as UC35
    usecase "Send Settlement Notification" as UC36
  }
}

' RELATIONSHIPS - UNLOGGED USER
u_user --> UC1
u_user --> UC2
u_user --> UC37

' RELATIONSHIPS - LOGGED USER - Only connect to packages to reduce clutter
l_user --> UC3
l_user --> UC4
l_user --> UC13
l_user --> UC14
l_user --> UC23
l_user --> UC30

' RELATIONSHIPS - HOUSEHOLD MANAGEMENT
UC23 <.. UC24 : <<extend>>
UC23 <.. UC25 : <<extend>>
UC24 <.. UC26 : <<extend>>
UC24 <.. UC27 : <<extend>>
UC24 <.. UC29 : <<extend>>
UC13 <.. UC28 : <<extend>>

' RELATIONSHIPS - TASK MANAGEMENT
UC30 <.. UC31 : <<extend>>
UC30 <.. UC32 : <<extend>>

' RELATIONSHIPS - SYSTEM
system --> UC33
system --> UC34
system --> UC35
system --> UC36

' RELATIONSHIPS BETWEEN USE CASES
UC21 ..> UC34 : <<include>>
UC21 ..> UC35 : <<include>>
UC28 ..> UC36 : <<include>>

@enduml