@startuml Choruko_Class_Diagram

title Choruko System - Class Diagram
left to right direction
skinparam classAttributeIconSize 0
skinparam linetype ortho

' --- Enums ---
enum InvitationStatus {
  Pending
  Accpted
  Declined
}

enum TaskStatus {
  PENDING
  ASSIGNED
  COMPLETED
}

enum SettlementStatus {
  PENDING
  COMPLETED
}

enum UserRole {
    None
    Participant
    HouseholdAdmin
}

' --- Core Classes ---

class User {
  -userUUID: string
  -email: string
  -firstName: string
  -lastName: string
  -password: string
  -salt: string
  -hashedPassword: string
  -profilePicturePath: string
  -role: UserRole
  -householdUUID: string
  -asignedTasks: List<Task>
  +register(firstName, lastName, email, password): boolean
  +login(email, password) : bool
  +deleteAccount(): void
  +resetPasswordRequest(email): void
  +changePassword(oldPassword, newPassword): boolean
  +changeMail(newMail) : boolean
  +setProfilePicture(url): void
  +editProfile(firstName, lastName): void
  }

class Points {
    -userUUID : string
    -householdUUID : string
    -points: int
}

class Household {
  -householdUUID: string
  -name: string
  -adminUserUUID: string
  +createHousehold(User.email, User.role) : boolean
  +deleteHousehold(adminUserUUID) : void
  +leaveHousehold(User.email, User.role) : void
  +removeParticipant(adminUserUUID, email): void
  +transferAdminRights(adminUserUUID, email): void
  +viewHouseholdInvitations(User.role) : List<Invitation>
  +sendHouseholdInvitation(role, newUserRole, email) : boolean
  +acceptHouseholdInvitation(role, Invitation) : void
  +declineHouseholdInvitation(role) : void
}

class Invitation {
  -invitationUUID: string
  -senderUUID: UUID        
  -receiverEmail: string   
  -householdUUID: UUID      
  -status: InvitationStatus 
  -sentAt: datetime
}

class Notification {
  -notificationUUID: string
  -message: string
  -timestamp: DateTime
  +delete(): void
  +getRecipient(): User
}

class Settlement {
  -settlementUUID: string
  -householdUUID: string
  -creatorUUID: string
  -description: string
  -amount: float
  -dueDate: DateTime
  -status: SettlementStatus
  +addSettlement(description, amount, List<User>, househoUUID, creatorUUID): Settlement
  +editSettlement(newDescription, newAmount, newParticipants): void
  +markCompleted(): void
  +unmarkCompleted(): void
  +deleteSettlement(): void
}

class Activity {
  -activityUUID: string
  -householdUUID: string
  -name: string
  +defineActivity(name, User.Role): Activity
  +editActivity(newName): void
  +deleteActivity(): void
}

class Task {
  -taskUUID: string
  -householdUUID: string
  -activityUUID: string
  -creatorUUID: string
  -timestamp: DateTime
  -dueDate: DateTime
  -status: TaskStatus
  -pointsAwarded: int
  -userAmount: int
  -name: string
  -description: string
  -assignees: List<User>
  +createTask(activity, householdUUID, dueDate, name, description): Task
  +editTask(newActivity, newDueDate, newAssignees, newName, newDescription): void
  +deleteTask(): void
  +assignTask(user: User): void
  +markAsCompleted(): void
  +unmarkAsCompleted(): void
}


' --- Relationships ---

User "1" *-- "0..*" Notification : receives
User "1" -- "0..*" Invitation : receives
User "1" -- "0..*" Points : earns
User "1" -- "0..*" Task : assigned >
User "0..*" -- "1" Household : member of
Household "1" *-- "0..*" Invitation : contains
Household "1" *-- "0..*" Activity : contains
Household "1" *-- "0..*" Task : contains
Household "1" *-- "0..*" Settlement : contains
Household "1" -- "1" User : admin >
Invitation "1" -- "1" User : sent by
Invitation "1" -- "1" User : sent to
Task "1" -- "0..*" User : assigned to
Task "1" -- "1" Activity : belongs to
Settlement "1" -- "1" User : created by
Settlement "1" -- "0..*" User : assigned to
Activity "1" -- "0..*" Task : assigned to
Points "1" -- "1" Household : for
Notification "1" -- "1" Invitation : about
Notification "1" -- "1" Task : about
Notification "1" -- "1" Settlement : about

' --- Enum Connections ---
InvitationStatus --> Invitation
TaskStatus --> Task
SettlementStatus --> Settlement
UserRole --> User


@enduml