@startuml notifications

title Choruko System - Notifications
skinparam usecaseBorderColor #000000
skinparam usecaseBackgroundColor #EEEEEE
skinparam packageStyle rectangle
skinparam linetype polyline
left to right direction

:Logged User: as l_user

rectangle "Choruko System" {
  usecase "View Notifications Panel" as UC30
  usecase "Delete Notification" as UC31
  usecase "Clear All Notifications" as UC32
}

l_user --> UC30
UC30 <.. UC31 : <<extend>>
UC30 <.. UC32 : <<extend>>

@enduml