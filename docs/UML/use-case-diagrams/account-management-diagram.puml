@startuml account-management

title Choruko System - Account Management
skinparam usecaseBorderColor #000000
skinparam usecaseBackgroundColor #EEEEEE
skinparam packageStyle rectangle
skinparam linetype polyline
left to right direction

:Unlogged User: as u_user
:Logged User: as l_user
:System: as system

rectangle "Choruko System" {
  usecase "Login" as UC1
  usecase "Register Account" as UC2
  usecase "Delete Account" as UC3
  usecase "Manage Account" as UC5
  usecase "Reset Password" as UC6
  usecase "Change Password" as UC10
  usecase "Set Profile Picture" as UC4
  usecase "Edit Profile Name" as UC9
  usecase "Send Password Reset E-mail" as UC7
  usecase "Remove Account from the Database" as UC8
}

u_user --> UC1
u_user --> UC2
u_user --> UC6
l_user --> UC5
UC5 <.. UC3 : <<extend>>
UC5 <.. UC10 : <<extend>>
UC5 <.. UC4 : <<extend>>
UC5 <.. UC9 : <<extend>>
UC6 ..> UC7 : <<include>>
UC3 ....> UC8 : <<include>>
UC7 <-- system 
UC8 <-- system

@enduml