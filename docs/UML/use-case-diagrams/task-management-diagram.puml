@startuml task-management

title Choruko System - Task Management
skinparam usecaseBorderColor #000000
skinparam usecaseBackgroundColor #EEEEEE
skinparam packageStyle rectangle
skinparam linetype polyline
left to right direction

:Logged User: as l_user
:System: as system

rectangle "Choruko System" {

  usecase "View Activity Panel" as UC13
  usecase "Define Activity" as UC14
  usecase "Edit Activity" as UC15
  usecase "Delete Activity" as UC16

  usecase "View Task Panel" as UC12
  usecase "Create Task" as UC17
  usecase "Delete Task" as UC18
  usecase "Assign Task" as UC19
  usecase "Edit Task" as UC20
  usecase "Mark Task as Completed" as UC21
  usecase "Unmark Task as Completed" as UC22

  usecase "Handle Points for Task" as UC34
  usecase "Send Task Notification" as UC35

  usecase "View Household Management Panel" as UC3
}

l_user --> UC12
l_user --> UC3

UC34 <-- system
UC35 <-- system

UC3 <.. UC13 : <<extend>>
UC13 <.. UC14 : <<extend>>
UC13 <.. UC15 : <<extend>>
UC13 <.. UC16 : <<extend>>
UC12 <.. UC17 : <<extend>>
UC12 <.. UC18 : <<extend>>
UC12 <.. UC19 : <<extend>>
UC12 <.. UC20 : <<extend>>
UC12 <.. UC21 : <<extend>>
UC12 <.. UC22 : <<extend>>

UC21 ..> UC34 : <<include>>
UC22 ..> UC34 : <<include>>
UC21 ..> UC35 : <<include>>
UC19 ..> UC35 : <<include>>
UC20 ..> UC35 : <<include>>
UC22 ..> UC35 : <<include>>

@enduml