@startuml household-management

title Choruko System - Household Management
skinparam usecaseBorderColor #000000
skinparam usecaseBackgroundColor #EEEEEE
skinparam packageStyle rectangle
skinparam linetype polyline
left to right direction

:Logged User: as l_user

rectangle "Choruko System" {
  usecase "Manage Household" as UC3
  usecase "Create Household" as UC4
  usecase "Delete Household" as UC5
  usecase "Edit Household Name" as UC1
  usecase "Set Household Picture" as UC2
  usecase "Leave Household" as UC12
  usecase "Transfer Household Admin Rights" as UC6
  usecase "Remove Participant" as UC8

  usecase "View Invitations Panel" as UC9
  usecase "Send Household Invitation" as UC7  
  usecase "Accept Invitation" as UC10
  usecase "Decline Invitation" as UC11
}

l_user --> UC3
l_user --> UC4
l_user --> UC12
UC3 <.. UC1 : <<extend>>
UC3 <.. UC2 : <<extend>>
UC3 <.. UC5 : <<extend>>
UC3 <.. UC6 : <<extend>>
UC3 <.. UC8 : <<extend>>
UC12 <.. UC6 : <<extend>>

UC3 <.. UC9 : <<extend>>
UC9 <.. UC7 : <<extend>>
UC9 <.. UC10 : <<extend>>
UC9 <.. UC11 : <<extend>>

@enduml